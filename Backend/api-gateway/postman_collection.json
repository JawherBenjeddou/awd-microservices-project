{
  "info": {
    "name": "Atelier API Gateway",
    "description": "Requests that reach the AutoWorld microservices through the API gateway (http://localhost:8080). One folder per microservice. In the MS1 folder, run \"Create listing\" before the get, update and delete requests: it stores the new id in listingId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gatewayUrl", "value": "http://localhost:8080" },
    { "key": "listingId", "value": "1" }
  ],
  "item": [
    {
      "name": "MS1 - Vente de vehicules",
      "item": [
        {
          "name": "Hello (which instance answered)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Answered by an MS1 instance', () => pm.expect(pm.response.text()).to.include('vehicle-sales-service on port'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/vehicle-sales/api/listings/hello"
          }
        },
        {
          "name": "List listings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/vehicle-sales/api/listings"
          }
        },
        {
          "name": "Create listing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('listingId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendeurId\": 7,\n  \"titre\": \"Renault Clio 5 - tres bon etat\",\n  \"description\": \"Premiere main\",\n  \"prix\": 48500,\n  \"negociable\": true,\n  \"vehicule\": {\n    \"marque\": \"Renault\",\n    \"modele\": \"Clio 5\",\n    \"annee\": 2020,\n    \"kilometrage\": 61000,\n    \"carburant\": \"ESSENCE\"\n  }\n}"
            },
            "url": "{{gatewayUrl}}/vehicle-sales/api/listings"
          }
        },
        {
          "name": "Get listing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/vehicle-sales/api/listings/{{listingId}}"
          }
        },
        {
          "name": "Update listing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendeurId\": 7,\n  \"titre\": \"Renault Clio 5 - prix revu\",\n  \"description\": \"Premiere main\",\n  \"prix\": 47000,\n  \"negociable\": false,\n  \"statut\": \"PUBLIEE\",\n  \"vehicule\": {\n    \"marque\": \"Renault\",\n    \"modele\": \"Clio 5\",\n    \"annee\": 2020,\n    \"kilometrage\": 61500,\n    \"carburant\": \"ESSENCE\"\n  }\n}"
            },
            "url": "{{gatewayUrl}}/vehicle-sales/api/listings/{{listingId}}"
          }
        },
        {
          "name": "Delete listing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{gatewayUrl}}/vehicle-sales/api/listings/{{listingId}}"
          }
        },
        {
          "name": "OpenAPI document of MS1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Server URL is the gateway', () => pm.expect(pm.response.json().servers[0].url).to.include('/vehicle-sales'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/vehicle-sales/v3/api-docs"
          }
        }
      ]
    }
  ]
}
